DATABASE_URL=sqlite:///./ecowatt.db
# Optional MySQL: DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecowatt
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TARIFF_INR_PER_KWH=8
# Gmail SMTP: MAIL_PASS is the App Password generated for this exact MAIL_USER account.
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_16_character_google_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
SMTP_FROM=your_gmail_address@gmail.com
MAIL_SERVICE_URL=http://127.0.0.1:8025
MAIL_SERVICE_PORT=8025
MAIL_SERVICE_TOKEN=replace_with_a_random_shared_local_token
# Approval links must be reachable by recipients. Localhost works on this computer only.
PUBLIC_BASE_URL=http://localhost:8001
EMPTY_SECONDS=20
APPROVAL_EXPIRY_MINUTES=30
REJECT_COOLDOWN_MINUTES=30
TARIFF_INR_PER_KWH=8
